# Folder unggahan (news/, gallery/, site/): hanya melayani gambar,
# skrip tidak pernah dieksekusi dari sini.
Options -Indexes -ExecCGI
<FilesMatch "\.(php|phtml|phar|php[0-9]|pl|py|cgi|sh|html?|js)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
